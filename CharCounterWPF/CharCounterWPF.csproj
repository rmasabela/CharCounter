<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>CharCounter.ico</ApplicationIcon>

    <!-- Compatibilidad con el empaquetador WAP -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    
    <!-- Metadatos de la Aplicación y Ensamblado -->
    <AssemblyName>CharCounter</AssemblyName>
    <RootNamespace>RMALabs.CharCounterWPF</RootNamespace>
    <Product>CharCounter</Product>
    <Title>CharCounter</Title>
    <Company>RMA Labs</Company>
    <Authors>Ricardo Masabel</Authors>
    <Description>Modern, lightweight real-time text analysis and character counter by RMA Labs.</Description>
    <Copyright>Copyright © 2026 RMA Labs</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>

    <!-- Versión base (el flujo de CI inyectará las versiones específicas de cada release) -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="CharCounter.ico" />
  </ItemGroup>

</Project>
