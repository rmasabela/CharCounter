<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RMALabs.CharCounter.Core</RootNamespace>
    <AssemblyName>RMALabs.CharCounter.Core</AssemblyName>

    <!-- Habilita la resolución de assets cuando se compila desde el empaquetador WAP x64 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!-- Metadatos del Ensamblado -->
    <Product>CharCounter</Product>
    <Title>CharCounter.Core</Title>
    <Company>RMA Labs</Company>
    <Authors>Ricardo Masabel</Authors>
    <Description>Core high-performance text analysis and metrics engine for CharCounter application.</Description>
    <Copyright>Copyright © 2026 Ricardo Masabel (RMA Labs)</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>

    <!-- Versión base -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

</Project>
