<Window x:Class="RMALabs.CharCounter.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RMALabs.CharCounter.WPF.ViewModels"
        mc:Ignorable="d"
        Title="CharCounter - RMA Labs" 
        Height="550" Width="850"
        MinHeight="400" MinWidth="600"
        Icon="CharCounter.ico"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Text Input Area -->
            <RowDefinition Height="*"/>
            <!-- Metrics / Counters Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Footer / Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="CharCounter" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="by RMA Labs" FontSize="12" Foreground="Gray" Margin="8,6,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClear" Content="Clear Text" Padding="12,4" Margin="0,0,8,0" Command="{Binding ClearTextCommand}"/>
                <Button x:Name="BtnCopy" Content="Copy Text" Padding="12,4" Command="{Binding CopyTextCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Main Editor -->
        <TextBox x:Name="TxtInput" 
                 Grid.Row="1" 
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" 
                 FontSize="14" 
                 Padding="10"
                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Metrics Dashboard -->
        <Border Grid.Row="2" Margin="0,12,0,8" Padding="12" Background="#1A808080" CornerRadius="6">
            <UniformGrid Columns="5">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Characters" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LblTotalChars" Text="{Binding TotalCharsFormatted}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Chars (no spaces)" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LblCharsNoSpaces" Text="{Binding CharsNoSpacesFormatted}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Words" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LblWords" Text="{Binding WordsFormatted}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Lines" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LblLines" Text="{Binding LinesFormatted}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Reading Time" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LblReadingTime" Text="{Binding ReadingTimeFormatted}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- Status / Footer -->
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="LblStatus" Text="{Binding StatusText}" FontSize="11" Foreground="Gray" DockPanel.Dock="Left"/>
            <TextBlock Text="v1.0.0" FontSize="11" Foreground="Gray" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
